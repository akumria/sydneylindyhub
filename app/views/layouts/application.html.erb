<!DOCTYPE html>
<html lang="en-GB">
  <head>
    <%= render "layouts/google_analytics" %>
    <title>
      <%= content_for?(:title) ? yield(:title) : "#{tc('site_name')} - listings of Lindy Hop swing dance classes and socials" %>
    </title>
    <meta content="text/html; charset=utf-8" http-equiv="Content-Type">
    <meta content="initial-scale=1" name="viewport">
    <meta content="Duncan Stuart" name="author">
    <meta content="<%= content_for?(:description) ? yield(:description) : "#{tc('site_name')} is a listing of weekly Lindy Hop classes, regular socials, swing gigs and vintage clubs" %>" name="description">
    <link href="humans.txt" rel="author">
    <link rel="icon" href="/favicon.ico?v=sydney-1" sizes="16x16 32x32 48x48">
    <link rel="icon" href="/icon.svg?v=sydney-1" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=sydney-1" sizes="180x180">
    <link rel="manifest" href="/manifest.webmanifest?v=sydney-1">
    <meta name="theme-color" content="#102f3a">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <%= csrf_meta_tag %>
    <%= javascript_include_tag :application, defer: true %>
    <%= javascript_include_tag "pwa", defer: true %>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Jost:wght@500&display=swap">
    <%= stylesheet_link_tag "application", media: "screen" %>
    <meta content="none" name="msapplication-config">
    <%= yield :head %>
  </head>
  <%= content_tag(:body, class: "#{@controller_name} #{@action_name}") do %>
    <%= content_for?(:content) ? yield(:content) : yield %>
  <% end %>
</html>
