<h1><%= @event.persisted? ? "Edit workshop exception" : "Approve a workshop exception" %></h1>
<p>Use only for a relevant Sydney workshop with one confirmed public date. Approval notes stay private.</p>
<%= form_with model: @form, url: (@event.persisted? ? workshop_path(@event) : workshops_path), method: (@event.persisted? ? :patch : :post) do |f| %>
  <%= render "shared/error_messages", target: @form %>
  <div class="form-group"><%= f.label :title %><%= f.text_field :title %></div>
  <div class="form-group"><%= f.label :url, "Source / booking URL" %><%= f.text_field :url %></div>
  <div class="form-group"><%= f.label :venue_id, "Venue" %><%= f.select :venue_id, venue_select, include_blank: true %></div>
  <div class="form-group"><%= f.label :class_organiser_id, "Organiser" %><%= f.select :class_organiser_id, organiser_select, include_blank: true %></div>
  <div class="form-group"><%= f.label :class_style, "Dance style" %><%= f.text_field :class_style %></div>
  <div class="form-group"><%= f.label :date, "Confirmed date" %><%= f.date_field :date %></div>
  <div class="form-group"><%= f.label :cancelled %><%= f.check_box :cancelled %></div>
  <div class="form-group"><%= f.label :last_verified_at, "Last verified" %><%= f.datetime_local_field :last_verified_at %></div>
  <div class="form-group"><%= f.label :source_notes, "Private source notes" %><%= f.text_area :source_notes %></div>
  <div class="form-group"><%= f.label :workshop_exception_reason, "Why this workshop merits an exception (private)" %><%= f.text_area :workshop_exception_reason %></div>
  <%= f.submit "Save approved workshop", class: "button" %>
<% end %>
