<main class="page account">
  <h1>Account</h1>

  <%= button_to "Log out", logout_path, method: :delete, class: "button" %>

  <p>Signed in as <strong><%= user.name %></strong> (<%= user.email %>).</p>

  <h2>Disable editor login</h2>

  <p>This removes your email address from the approved editor list. An administrator must add it again before you can sign in.</p>

  <%= button_to "Disable my login", account_path, method: :delete, class: "button button-danger" %>
</main>
