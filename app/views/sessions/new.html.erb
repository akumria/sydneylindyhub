<section class="login">
  <%= render "shared/flash" %>

  <h2>Editor Login</h2>
  <p>Enter your approved editor email address. The sign-in link expires after 15 minutes.</p>
  <%= form_with url: login_path do |form| %>
    <div class="form-group">
      <%= form.label :email, "Email address" %>
      <%= form.email_field :email, required: true, autocomplete: "email" %>
    </div>
    <%= form.submit "Email me a sign-in link", class: "button" %>
  <% end %>
</section>
