#!/usr/bin/env bash
set -euo pipefail

gem install bundler --version 4.0.17 --no-document
bundle install

# The official Node image includes Yarn Classic links into /opt. Only
# /usr/local is copied into the Ruby image, so remove those dangling links and
# let Corepack create project-aware shims instead.
for yarn_link in /usr/local/bin/yarn /usr/local/bin/yarnpkg; do
  if [[ -L "$yarn_link" && ! -e "$yarn_link" ]]; then
    rm "$yarn_link"
  fi
done

corepack enable
corepack install
yarn install --immutable
yarn build

if [[ ! -f .env ]]; then
  cp .env.example .env
fi

# public/assets/ is gitignored build output, and nothing evicts files from it.
# A checkout or reused volume can therefore carry assets compiled from sources
# that have since changed, or been deleted, and they would be served in
# preference to the current build. Nothing in the repository lives here - the
# static error pages use public/application_http_errors.css - so clearing the
# directory is safe.
rm -rf public/assets

bin/rails dartsass:build
bin/rails db:prepare

echo "Development environment is ready. Run bin/dev to start the application."
