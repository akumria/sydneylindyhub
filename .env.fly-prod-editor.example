# Copy to .env.fly-prod-editor (ignored by Git). Never commit real values.
# Writable, direct Neon connection with TLS; do not use site_publisher.
DATABASE_URL=
# Generate once with: openssl rand -hex 64
SECRET_KEY_BASE=
# Current Rails mail configuration uses Fastmail SMTP with an app password.
SMTP_USER_NAME=
SMTP_PASSWORD=
GOOGLE_MAPS_JAVASCRIPT_API_KEY=
GOOGLE_MAPS_STATIC_API_KEY=
GOOGLE_MAPS_MAP_ID=

# Fine-grained token: this repository only, Actions read/write; no Contents write.
GITHUB_ACTIONS_TOKEN=
